{
  "Comment": "Insurance claims processing: ingestion followed by coverage",
  "StartAt": "Ingestion",
  "States": {
    "Ingestion": {
      "Type": "Task",
      "Resource": "${ingestion_lambda_arn}",
      "Next": "Coverage"
